{
  "name": "glucovision",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:preview": "opennextjs-cloudflare preview",
    "backend:dev": "wrangler dev --cwd backend --persist-to=./backend/.wrangler/state",
    "backend:deploy": "wrangler deploy --cwd backend",
    "backend:migrate": "wrangler d1 migrations apply glucovision --remote --cwd backend",
    "backend:seed": "wrangler d1 execute glucovision --remote --file=./backend/seed.sql --cwd backend"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "framer-motion": "^13.2.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
